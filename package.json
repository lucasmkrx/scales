{
  "name": "tukany",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive guitar and bass scale explorer with fretboard diagrams, alternate tunings, and printable scale atlases.",
  "homepage": "https://tukany.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasmkrx/tukany.git"
  },
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:backing-tracks": "node scripts/check-backing-tracks.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "generate": "node scripts/generate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.9.10"
  }
}
